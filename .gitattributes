# All text files default to LF
* text=auto eol=lf

# Ensure these are text, not binary
.cproject text eol=lf
.project text eol=lf
*.uidesign text eol=lf
*.svg text eol=lf

# Explicitly restate Symbian files
*.mmp text eol=lf
*.mk text eol=lf
*.inf text eol=lf
Makefile text eol=lf
ABLD.BAT text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.rss text eol=lf
*.rssi text eol=lf
*.loc text eol=lf
*.l01 text eol=lf
*.hrh text eol=lf
*.pan text eol=lf
*.pkg text eol=lf
*.xml text eol=lf

# Binary files
*.bmp binary
*.sis binary
*.sisx binary
*.db binary
