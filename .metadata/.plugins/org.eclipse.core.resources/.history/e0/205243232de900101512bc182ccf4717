void CgemrideContainerView::HandleCommandL(TInt aCommand)
	{
	// [[[ begin generated region: do not modify [Generated Code]
	TBool commandHandled = EFalse;
	switch ( aCommand )
		{	// code to dispatch to the AknView's menu and CBA commands is generated here
		case EGemrideContainerViewBackCommand:
			GoBackL();
			commandHandled = ETrue;
			break;
		default:
			break;
		}


	if ( !commandHandled ) 
		{

		if ( aCommand == EAknSoftkeyExit )
			{
			AppUi()->HandleCommandL( EEikCmdExit );
			}

		}
	// ]]] end generated region [Generated Code]

	}

void CgemrideContainerView::DoActivateL(
        const TVwsViewId& /*aPrevViewId*/,
        TUid /*aCustomMessageId*/,
        const TDesC8& /*aCustomMessage*/)
    {
    SetupStatusPaneL();

    if (iGemrideContainer == NULL)
        {
        iGemrideContainer = CreateContainerL();
        iGemrideContainer->SetMopParent(this);
        AppUi()->AddToStackL(*this, iGemrideContainer);
        }

    _LIT8(KStartUrl, "gemini://zaibatsu.circumlunar.space/~solderpunk/gemlog/");

    // Store as current URL
    delete iCurrentUrl;
    iCurrentUrl = NULL;
    iCurrentUrl = KStartUrl().AllocL();

    if (iGemrideContainer)
        {
        iGemrideContainer->SetLoadingL(ETrue, KStartUrl);
        }

    iEngine->FetchL(KStartUrl);
    UpdateCbaL();
    }

void CgemrideContainerView::DoDeactivate()
	{
	// [[[ begin generated region: do not modify [Generated Contents]
	CleanupStatusPane();

	if ( iGemrideContainer != NULL )
		{
		AppUi()->RemoveFromViewStack( *this, iGemrideContainer );
		delete iGemrideContainer;
		iGemrideContainer = NULL;
		}
	// ]]] end generated region [Generated Contents]

	}

