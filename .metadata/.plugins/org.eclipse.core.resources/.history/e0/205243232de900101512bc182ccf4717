void CgemrideContainerView::PushCurrentUrlL()
    {
    if (iCurrentUrl && iCurrentUrl->Length() > 0)
        {
        HBufC8* urlCopy = iCurrentUrl->AllocLC();
        iHistoryStack.AppendL(urlCopy);
        CleanupStack::Pop(urlCopy);
        }
    }

void CgemrideContainerView::NavigateToL(const TDesC& aUrl)
    {
    if (!iEngine)
        return;

    RDebug::Print(_L("NavigateToL input: %S"), &aUrl);
    
    // Resolve the URL against current base
    HBufC* resolvedUrl = ResolveUrlLC(aUrl);

    // Push current URL to history before navigating
    PushCurrentUrlL();

    // Convert 16-bit URL to 8-bit
    HBufC8* url8 = HBufC8::NewLC(resolvedUrl->Length());
    url8->Des().Copy(*resolvedUrl);

    // Update current URL
    delete iCurrentUrl;
    iCurrentUrl = NULL;
    iCurrentUrl = url8->AllocL();

    if (iGemrideContainer)
        {
        iGemrideContainer->SetLoadingL(ETrue, *url8);
        }

    iEngine->FetchL(*url8);

    CleanupStack::PopAndDestroy(2, resolvedUrl);  // url8, resolvedUrl

    UpdateCbaL();
    }

void CgemrideContainerView::GoBackL()
    {
    if (iHistoryStack.Count() == 0)
        return;

    // Pop last URL from history
    TInt lastIndex = iHistoryStack.Count() - 1;
    HBufC8* previousUrl = iHistoryStack[lastIndex];
    iHistoryStack.Remove(lastIndex);

    // Update current URL (don't push to history - we're going back)
    delete iCurrentUrl;
    iCurrentUrl = previousUrl;  // Take ownership

    if (iGemrideContainer)
        {
        iGemrideContainer->SetLoadingL(ETrue, *iCurrentUrl);
        }

    iEngine->FetchL(*iCurrentUrl);

    UpdateCbaL();
    }

TBool CgemrideContainerView::CanGoBack() const
    {
    return iHistoryStack.Count() > 0;
    }

void CgemrideContainerView::UpdateCbaL()
    {
    CEikButtonGroupContainer* cba = Cba();
    if (!cba)
        return;

    if (CanGoBack())
        {
        cba->SetCommandL(2, EGemrideContainerViewBackCommand, _L("Back"));
        }
    else
        {
        cba->SetCommandL(2, EAknSoftkeyExit, _L("Exit"));
        }

    cba->DrawNow();
    }

HBufC* CgemrideContainerView::ResolveUrlLC(const TDesC& aUrl)
    {
    // Check if already absolute (has scheme)
    _LIT(KGeminiScheme, "gemini://");
    _LIT(KGopherScheme, "gopher://");
    _LIT(KHttpScheme, "http://");
    _LIT(KHttpsScheme, "https://");

    if (aUrl.FindF(KGeminiScheme) == 0 ||
        aUrl.FindF(KGopherScheme) == 0 ||
        aUrl.FindF(KHttpScheme) == 0 ||
        aUrl.FindF(KHttpsScheme) == 0)
        {
        // Already absolute
        return aUrl.AllocLC();
        }

    // Need base URL to resolve
    if (!iCurrentUrl || iCurrentUrl->Length() == 0)
        {
        return aUrl.AllocLC();
        }

    // Convert current URL to 16-bit for processing
    HBufC* base = HBufC::NewLC(iCurrentUrl->Length());
    base->Des().Copy(*iCurrentUrl);

    HBufC* result = NULL;

    if (aUrl.Length() > 0 && aUrl[0] == '/')
        {
        // Absolute path - find host part of base URL
        // gemini://host/path -> gemini://host + /newpath
        TInt schemeEnd = base->Find(_L("://"));
        if (schemeEnd != KErrNotFound)
            {
            TPtrC afterScheme = base->Mid(schemeEnd + 3);
            TInt slashPos = afterScheme.Locate('/');
            TInt hostEnd;
            if (slashPos != KErrNotFound)
                {
                hostEnd = schemeEnd + 3 + slashPos;
                }
            else
                {
                hostEnd = base->Length();
                }

            result = HBufC::NewL(hostEnd + aUrl.Length());
            result->Des().Copy(base->Left(hostEnd));
            result->Des().Append(aUrl);
            }
        }
    else
        {
        // Relative path - resolve against base directory
        // Find last slash in base URL (directory part)
        TInt lastSlash = base->LocateReverse('/');
        TInt schemeEnd = base->Find(_L("://"));

        // Make sure we don't cut into the scheme
        if (lastSlash != KErrNotFound && lastSlash > schemeEnd + 2)
            {
            TPtrC baseDir = base->Left(lastSlash + 1);
            result = HBufC::NewL(baseDir.Length() + aUrl.Length());
            result->Des().Copy(baseDir);
            result->Des().Append(aUrl);
            }
        else
            {
            // No path in base, append with slash
            result = HBufC::NewL(base->Length() + 1 + aUrl.Length());
            result->Des().Copy(*base);
            if (base->Length() > 0 && (*base)[base->Length()-1] != '/')
                {
                result->Des().Append('/');
                }
            result->Des().Append(aUrl);
            }
        }

    CleanupStack::PopAndDestroy(base);

    if (result)
        {
        CleanupStack::PushL(result);
        return result;
        }

    return aUrl.AllocLC();
    }

