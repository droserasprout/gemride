CGemrideContainer::~CGemrideContainer()
    {
    delete iContent;
    delete iParser;
    }

CGemrideContainer* CGemrideContainer::NewL(
        const TRect& aRect,
        const CCoeControl* aParent,
        MEikCommandObserver* aCommandObserver)
    {
    CGemrideContainer* self = CGemrideContainer::NewLC(aRect, aParent, aCommandObserver);
    CleanupStack::Pop(self);
    return self;
    }

CGemrideContainer* CGemrideContainer::NewLC(
        const TRect& aRect,
        const CCoeControl* aParent,
        MEikCommandObserver* aCommandObserver)
