CgemrideContainerView::CgemrideContainerView()
	: iGemrideContainer(NULL), iEngine(NULL)
	{
	}

CgemrideContainerView::~CgemrideContainerView()
	{
	delete iGemrideContainer;
	delete iEngine;
	}

CgemrideContainerView* CgemrideContainerView::NewL()
	{
	CgemrideContainerView* self = CgemrideContainerView::NewLC();
	CleanupStack::Pop(self);
	return self;
	}

CgemrideContainerView* CgemrideContainerView::NewLC()
	{
	CgemrideContainerView* self = new (ELeave) CgemrideContainerView();
	CleanupStack::PushL(self);
	self->ConstructL();
	return self;
	}

void CgemrideContainerView::ConstructL()
	{
	BaseConstructL(R_GEMRIDE_CONTAINER_GEMRIDE_CONTAINER_VIEW);
	iEngine = CGeminiEngine::NewL(*this);
	}

TUid CgemrideContainerView::Id() const
	{
	return TUid::Uid(EGemrideContainerViewId);
	}

void CgemrideContainerView::HandleCommandL(TInt aCommand)
	{
	if (aCommand == EAknSoftkeyExit)
		{
		AppUi()->HandleCommandL(EEikCmdExit);
		}
	}

void CgemrideContainerView::DoActivateL(
		const TVwsViewId& /*aPrevViewId*/,
		TUid /*aCustomMessageId*/,
		const TDesC8& /*aCustomMessage*/)
	{
	SetupStatusPaneL();

	if (iGemrideContainer == NULL)
		{
		iGemrideContainer = CreateContainerL();
		iGemrideContainer->SetMopParent(this);
		AppUi()->AddToStackL(*this, iGemrideContainer);
		}

	// TEST: Fetch a simple Gemini page
	_LIT8(KTestUrl, "gemini://geminiprotocol.net/");
	iEngine->FetchL(KTestUrl);
	}

void CgemrideContainerView::DoDeactivate()
	{
	CleanupStatusPane();

	if (iGemrideContainer != NULL)
		{
		AppUi()->RemoveFromViewStack(*this, iGemrideContainer);
		delete iGemrideContainer;
		iGemrideContainer = NULL;
		}
	}

void CgemrideContainerView::HandleStatusPaneSizeChange()
	{
	CAknView::HandleStatusPaneSizeChange();

	TVwsViewId view;
	AppUi()->GetActiveViewId(view);
	if (view.iViewUid == Id())
		{
		TInt result;
		TRAP(result, SetupStatusPaneL());
		}
	}

void CgemrideContainerView::SetupStatusPaneL()
	{
	TUid contextPaneUid = TUid::Uid(EEikStatusPaneUidContext);
	CEikStatusPaneBase::TPaneCapabilities subPaneContext =
		StatusPane()->PaneCapabilities(contextPaneUid);
	if (subPaneContext.IsPresent() && subPaneContext.IsAppOwned())
		{
		CAknContextPane* context = static_cast<CAknContextPane*>(
			StatusPane()->ControlL(contextPaneUid));
		context->SetPictureToDefaultL();
		}

	TUid titlePaneUid = TUid::Uid(EEikStatusPaneUidTitle);
	CEikStatusPaneBase::TPaneCapabilities subPaneTitle =
		StatusPane()->PaneCapabilities(titlePaneUid);
	if (subPaneTitle.IsPresent() && subPaneTitle.IsAppOwned())
		{
		CAknTitlePane* title = static_cast<CAknTitlePane*>(
			StatusPane()->ControlL(titlePaneUid));
		TResourceReader reader;
		iEikonEnv->CreateResourceReaderLC(reader, R_GEMRIDE_CONTAINER_TITLE_RESOURCE);
		title->SetFromResourceL(reader);
		CleanupStack::PopAndDestroy();
		}
	}

void CgemrideContainerView::CleanupStatusPane()
	{
	}

CGemrideContainer* CgemrideContainerView::CreateContainerL()
	{
	return CGemrideContainer::NewL(ClientRect(), NULL, this);
	}

void CgemrideContainerView::OnConnecting()
	{
	if (iGemrideContainer)
		{
		iGemrideContainer->SetLoading(ETrue);
		}
	}

void CgemrideContainerView::OnResponseReceived(const TDesC8& aStatus,
	const TDesC8& aMeta, const TDesC8& aBody)
	{
	RDebug::Print(_L("View: OnResponseReceived called, body len=%d"), aBody.Length());

	HBufC* text = HBufC::NewLC(aBody.Length());
	TPtr ptr = text->Des();
	ptr.Copy(aBody);

	RDebug::Print(_L("View: Converted text len=%d"), text->Length());

	if (iGemrideContainer)
		{
		RDebug::Print(_L("View: Container exists, calling SetContentL"));
		TRAPD(err, iGemrideContainer->SetContentL(*text));
		RDebug::Print(_L("View: SetContentL returned %d"), err);
		}
	else
		{
		RDebug::Print(_L("View: Container is NULL!"));
		}

	CleanupStack::PopAndDestroy(text);
	}

void CgemrideContainerView::OnError(TInt aError, const TDesC& aMessage)
	{
	CEikonEnv::Static()->InfoMsg(aMessage);
	}
