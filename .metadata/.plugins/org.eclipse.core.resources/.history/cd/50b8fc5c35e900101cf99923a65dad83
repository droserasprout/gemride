void CgemrideContainerView::PushCurrentUrlL()
    {
    if (iCurrentUrl && iCurrentUrl->Length() > 0)
        {
        HBufC8* urlCopy = iCurrentUrl->AllocLC();
        iHistoryStack.AppendL(urlCopy);
        CleanupStack::Pop(urlCopy);
        }
    }

void CgemrideContainerView::NavigateToL(const TDesC& aUrl)
    {
    if (!iEngine)
        return;

    RDebug::Print(_L("NavigateToL input: %S"), &aUrl);

    // Resolve the URL against current base
    HBufC* resolvedUrl = ResolveUrlLC(aUrl);

    RDebug::Print(_L("NavigateToL resolved: %S"), resolvedUrl);

    // Push current URL to history before navigating
    PushCurrentUrlL();

    // Convert 16-bit URL to 8-bit
    HBufC8* url8 = HBufC8::NewLC(resolvedUrl->Length());
    url8->Des().Copy(*resolvedUrl);

    // Update current URL
    delete iCurrentUrl;
    iCurrentUrl = NULL;
    iCurrentUrl = url8->AllocL();

    if (iGemrideContainer)
        {
        iGemrideContainer->SetLoadingL(ETrue, *url8);
        }

    iEngine->FetchL(*url8);

    CleanupStack::PopAndDestroy(2, resolvedUrl);  // url8, resolvedUrl

    UpdateCbaL();
    }

void CgemrideContainerView::GoBackL()
    {
    if (iHistoryStack.Count() == 0)
        return;

    // Pop last URL from history
    TInt lastIndex = iHistoryStack.Count() - 1;
    HBufC8* previousUrl = iHistoryStack[lastIndex];
    iHistoryStack.Remove(lastIndex);

    // Update current URL (don't push to history - we're going back)
    delete iCurrentUrl;
    iCurrentUrl = previousUrl;  // Take ownership

    if (iGemrideContainer)
        {
        iGemrideContainer->SetLoadingL(ETrue, *iCurrentUrl);
        }

    iEngine->FetchL(*iCurrentUrl);

    UpdateCbaL();
    }

TBool CgemrideContainerView::CanGoBack() const
    {
    return iHistoryStack.Count() > 0;
    }

void CgemrideContainerView::UpdateCbaL()
    {
    CEikButtonGroupContainer* cba = Cba();
    if (!cba)
        return;

    if (CanGoBack())
        {
        cba->SetCommandL(2, EGemrideContainerViewBackCommand, _L("Back"));
        }
    else
        {
        cba->SetCommandL(2, EAknSoftkeyExit, _L("Exit"));
        }

    cba->DrawNow();
    }

HBufC* CgemrideContainerView::ResolveUrlLC(const TDesC& aUrl)
    {
    _LIT(KGeminiScheme, "gemini://");
    const TInt KSchemeLen = 9;  // Length of "gemini://"

    // Already absolute URL
    if (aUrl.Length() >= KSchemeLen && aUrl.Left(KSchemeLen).CompareF(KGeminiScheme) == 0)
        {
        return aUrl.AllocLC();
        }

    if (!iCurrentUrl || iCurrentUrl->Length() == 0)
        {
        return aUrl.AllocLC();
        }

    // Convert base to 16-bit
    HBufC* base = HBufC::NewLC(iCurrentUrl->Length() + 1);
    base->Des().Copy(*iCurrentUrl);

    RDebug::Print(_L("ResolveUrl base: %S"), base);
    RDebug::Print(_L("ResolveUrl input: %S"), &aUrl);

    // Find host end (first slash after scheme)
    TInt hostEnd = KErrNotFound;
    if (base->Length() > KSchemeLen)
        {
        TPtrC afterScheme = base->Mid(KSchemeLen);
        TInt slashPos = afterScheme.Locate('/');
        if (slashPos != KErrNotFound)
            {
            hostEnd = KSchemeLen + slashPos;
            }
        else
            {
            hostEnd = base->Length();
            }
        }
    else
        {
        CleanupStack::PopAndDestroy(base);
        return aUrl.AllocLC();
        }

    RDebug::Print(_L("ResolveUrl hostEnd: %d"), hostEnd);

    HBufC* result = NULL;

    if (aUrl.Length() > 0 && aUrl[0] == '/')
        {
        // Absolute path from host root
        result = HBufC::NewL(hostEnd + aUrl.Length());
        result->Des().Copy(base->Left(hostEnd));
        result->Des().Append(aUrl);
        }
    else
        {
        // Get base directory (everything up to and including last slash)
        TInt lastSlash = base->LocateReverse('/');
        RDebug::Print(_L("ResolveUrl lastSlash: %d"), lastSlash);

        TInt baseDirLen;
        if (lastSlash > hostEnd)
            {
            baseDirLen = lastSlash + 1;  // Include the slash
            }
        else
            {
            baseDirLen = base->Length();
            // Add trailing slash if needed
            }

        RDebug::Print(_L("ResolveUrl baseDirLen: %d"), baseDirLen);

        // Count ../ prefixes
        TInt relStart = 0;
        TInt dirsUp = 0;

        while (relStart + 3 <= aUrl.Length())
            {
            if (aUrl.Mid(relStart, 3).Compare(_L("../")) == 0)
                {
                dirsUp++;
                relStart += 3;
                }
            else
                {
                break;
                }
            }

        // Handle trailing .. without slash
        if (relStart + 2 == aUrl.Length() && aUrl.Mid(relStart, 2).Compare(_L("..")) == 0)
            {
            dirsUp++;
            relStart += 2;
            }

        RDebug::Print(_L("ResolveUrl dirsUp: %d relStart: %d"), dirsUp, relStart);

        // Go up directories
        TInt currentEnd = baseDirLen;
        if (currentEnd > 0 && (*base)[currentEnd - 1] == '/')
            {
            currentEnd--;  // Don't count trailing slash
            }

        for (TInt i = 0; i < dirsUp; i++)
            {
            // Find previous slash, but don't go past host
            while (currentEnd > hostEnd && (*base)[currentEnd] != '/')
                {
                currentEnd--;
                }
            if (currentEnd > hostEnd)
                {
                currentEnd--;  // Move past the slash
                }
            }

        // Find the slash position for our base
        while (currentEnd > hostEnd && (*base)[currentEnd] != '/')
            {
            currentEnd--;
            }
        currentEnd++;  // Include the slash

        RDebug::Print(_L("ResolveUrl currentEnd: %d"), currentEnd);

        // Get remaining part of relative URL
        TPtrC remainder = aUrl.Mid(relStart);
        RDebug::Print(_L("ResolveUrl remainder: %S"), &remainder);

        // Build result
        result = HBufC::NewL(currentEnd + remainder.Length() + 1);
        result->Des().Copy(base->Left(currentEnd));
        result->Des().Append(remainder);
        }

    CleanupStack::PopAndDestroy(base);

    RDebug::Print(_L("ResolveUrl result: %S"), result);

    CleanupStack::PushL(result);
    return result;
    }

