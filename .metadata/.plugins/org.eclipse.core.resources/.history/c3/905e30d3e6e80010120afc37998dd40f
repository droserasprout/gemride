#include <e32base.h>  // For CPeriodic
#include "GeminiEngine.h"

const TInt KGeminiPort = 1965;
const TInt KMaxRecvBuffer = 65536;

CGeminiEngine* CGeminiEngine::NewL(MGeminiObserver& aObserver)
	{
	CGeminiEngine* self = new (ELeave) CGeminiEngine(aObserver);
	CleanupStack::PushL(self);
	self->ConstructL();
	CleanupStack::Pop(self);
	return self;
	}

CGeminiEngine::CGeminiEngine(MGeminiObserver& aObserver)
    : CActive(EPriorityStandard),
      iObserver(aObserver),
      iState(EIdle),
      iRetryCount(0),
      iRetryTimer(NULL)
    {
    CActiveScheduler::Add(this);
    }

void CGeminiEngine::ConstructL()
	{
	User::LeaveIfError(iSocketServ.Connect());
	iRecvBuffer = HBufC8::NewL(4096);  // Initial size, will grow
	}

CGeminiEngine::~CGeminiEngine()
    {
    Cancel();
    if (iRetryTimer)
        {
        iRetryTimer->Cancel();
        delete iRetryTimer;
        }
    delete iSecureSocket;
    iSocket.Close();
    iResolver.Close();
    iSocketServ.Close();
    delete iUrl;
    delete iHost;
    delete iSendBuffer;
    delete iRecvBuffer;
    }


void CGeminiEngine::FetchL(const TDesC8& aUrl)
	{
	RDebug::Print(_L("GeminiEngine: FetchL called"));

	
	// Reset state
	delete iUrl;
	iUrl = NULL;
	delete iHost;
	iHost = NULL;
	iPort = 1965;  // Default Gemini port

	// Store full URL
	iUrl = aUrl.AllocL();

	// Parse: gemini://host[:port]/path
	// Skip "gemini://"
	TPtrC8 remaining = aUrl;
	_LIT8(KScheme, "gemini://");
	if (remaining.FindF(KScheme) == 0)
		{
		remaining.Set(remaining.Mid(KScheme().Length()));
		}

	// Find end of host (first / or end of string)
	TInt slashPos = remaining.Locate('/');
	TPtrC8 hostPort;
	if (slashPos != KErrNotFound)
		{
		hostPort.Set(remaining.Left(slashPos));
		}
	else
		{
		hostPort.Set(remaining);
		}

	// Check for port
	TInt colonPos = hostPort.Locate(':');
	if (colonPos != KErrNotFound)
		{
		// Extract port
		TPtrC8 portStr = hostPort.Mid(colonPos + 1);
		TLex8 lex(portStr);
		lex.Val(iPort);
		iHost = hostPort.Left(colonPos).AllocL();
		}
	else
		{
		iHost = hostPort.AllocL();
		}

	iObserver.OnConnecting();
	RDebug::Print(_L("GeminiEngine: Starting DNS resolve for host"));
	ResolveHostL(*iHost);
	}

void CGeminiEngine::ResolveHostL(const TDesC8& aHost)
	{
	RDebug::Print(_L("GeminiEngine: ResolveHostL"));
	User::LeaveIfError(iResolver.Open(iSocketServ, KAfInet, KProtocolInetTcp));

	// Convert 8-bit host to 16-bit for resolver
	TBuf<256> host16;
	host16.Copy(aHost);

	iResolver.GetByName(host16, iNameEntry, iStatus);
	iState = EResolvingHost;
	SetActive();
	}

void CGeminiEngine::ConnectL()
	{
	// Get resolved address
	TInetAddr addr = TInetAddr::Cast(iNameEntry().iAddr);
	addr.SetPort(iPort);

	// Open TCP socket
	User::LeaveIfError(iSocket.Open(iSocketServ, KAfInet, KSockStream, KProtocolInetTcp));

	// Connect
	iSocket.Connect(addr, iStatus);
	iState = EConnecting;
	SetActive();
	}

void CGeminiEngine::StartHandshakeL()
	{
	iSecureSocket = CSecureSocket::NewL(iSocket, _L("TLS1.0"));
	// With nnproject patch, this negotiates TLS 1.2
	iSecureSocket->StartClientHandshake(iStatus);
	iState = EHandshaking;
	SetActive();
	}

void CGeminiEngine::SendRequestL()
	{
	// Gemini request: URL + CRLF
	iSendBuffer = HBufC8::NewL(iUrl->Length() + 2);
	iSendBuffer->Des().Copy(*iUrl);
	iSendBuffer->Des().Append(_L8("\r\n"));

	iSecureSocket->Send(*iSendBuffer, iStatus);
	iState = ESending;
	SetActive();
	}

void CGeminiEngine::ReceiveResponseL()
	{
	iTempRecvBuf.Zero();
	iSecureSocket->RecvOneOrMore(iTempRecvBuf, iStatus, iRecvLen);
	iState = EReceiving;
	SetActive();
	}

void CGeminiEngine::ParseResponse()
	{
	RDebug::Print(_L("GeminiEngine: ParseResponse, buffer len=%d"), iRecvBuffer->Length());

	// Log first 100 chars of raw response
	TBuf<100> preview;
	preview.Copy(iRecvBuffer->Des().Left(100));
	RDebug::Print(_L("GeminiEngine: Raw data: %S"), &preview);

	const TDesC8& data = *iRecvBuffer;

	TInt crlfPos = data.Find(_L8("\r\n"));
	RDebug::Print(_L("GeminiEngine: CRLF at pos %d"), crlfPos);

	if (crlfPos == KErrNotFound || crlfPos < 2)
		{
		iObserver.OnError(KErrCorrupt, _L("Invalid response"));
		return;
		}

	TPtrC8 statusLine = data.Left(crlfPos);
	TPtrC8 statusCode = statusLine.Left(2);

	TPtrC8 meta;
	if (statusLine.Length() > 3)
		{
		meta.Set(statusLine.Mid(3));
		}

	TPtrC8 body;
	if (data.Length() > crlfPos + 2)
		{
		body.Set(data.Mid(crlfPos + 2));
		}

	RDebug::Print(_L("GeminiEngine: Calling OnResponseReceived, body len=%d"), body.Length());
	iObserver.OnResponseReceived(statusCode, meta, body);
	iState = EIdle;
	}

void CGeminiEngine::RunL()
	{
	RDebug::Print(_L("GeminiEngine: RunL State=%d Status=%d"), iState, iStatus.Int());

	switch (iState)
		{
		case EResolvingHost:
			if (iStatus.Int() != KErrNone)
				{
				iObserver.OnError(iStatus.Int(), _L("DNS lookup failed"));
				return;
				}
			ConnectL();
			break;

		case EConnecting:
			if (iStatus.Int() != KErrNone)
				{
				iObserver.OnError(iStatus.Int(), _L("Connection failed"));
				return;
				}
			StartHandshakeL();
			break;

		case EHandshaking:
			if (iStatus.Int() != KErrNone)
				{
				iObserver.OnError(iStatus.Int(), _L("TLS handshake failed"));
				return;
				}
			SendRequestL();
			break;

		case ESending:
			if (iStatus.Int() != KErrNone)
				{
				iObserver.OnError(iStatus.Int(), _L("Send failed"));
				return;
				}
			// Clear buffer before first receive
			iRecvBuffer->Des().Zero();
			ReceiveResponseL();
			break;

		case EReceiving:
		    if (iStatus.Int() == KErrNone)
		        {
		        // Append received data to main buffer
		        TInt newLen = iRecvBuffer->Length() + iTempRecvBuf.Length();
		        if (newLen > iRecvBuffer->Des().MaxLength())
		            {
		            iRecvBuffer = iRecvBuffer->ReAllocL(newLen + 4096);
		            }
		        iRecvBuffer->Des().Append(iTempRecvBuf);

		        // Notify observer of bytes received
		        iObserver.OnBytesReceived(iTempRecvBuf.Length());  // NEW

		        RDebug::Print(_L("GeminiEngine: Received chunk, total now %d bytes"),
		            iRecvBuffer->Length());

		        ReceiveResponseL();
		        }
			else if (iStatus.Int() == KErrEof)
				{
				// Server closed connection - we have complete response
				RDebug::Print(_L("GeminiEngine: EOF, total %d bytes"), iRecvBuffer->Length());
				ParseResponse();
				}
			else
				{
				// Actual error
				iObserver.OnError(iStatus.Int(), _L("Receive failed"));
				}
			break;

		default:
			break;
		}
	}

TInt CGeminiEngine::RunError(TInt aError)
	{
	RDebug::Print(_L("GeminiEngine: RunError called with %d"), aError);
	TBuf<64> msg;
	msg.Format(_L("Exception: %d"), aError);
	iObserver.OnError(aError, msg);
	iState = EIdle;
	return KErrNone;
	}

void CGeminiEngine::DoCancel()
	{
	if (iSecureSocket)
		iSecureSocket->CancelAll();
	iSocket.CancelAll();
	iResolver.Cancel();
	}
