void CgemrideContainerView::PushCurrentUrlL()
    {
    if (iCurrentUrl && iCurrentUrl->Length() > 0)
        {
        HBufC8* urlCopy = iCurrentUrl->AllocLC();
        iHistoryStack.AppendL(urlCopy);
        CleanupStack::Pop(urlCopy);
        }
    }

void CgemrideContainerView::NavigateToL(const TDesC& aUrl)
    {
    if (!iEngine)
        return;

    RDebug::Print(_L("NavigateToL input: %S"), &aUrl);

    // Resolve the URL against current base
    HBufC* resolvedUrl = ResolveUrlLC(aUrl);

    RDebug::Print(_L("NavigateToL resolved: %S"), resolvedUrl);

    // Push current URL to history before navigating
    PushCurrentUrlL();

    // Convert 16-bit URL to 8-bit
    HBufC8* url8 = HBufC8::NewLC(resolvedUrl->Length());
    url8->Des().Copy(*resolvedUrl);

    // Update current URL
    delete iCurrentUrl;
    iCurrentUrl = NULL;
    iCurrentUrl = url8->AllocL();

    if (iGemrideContainer)
        {
        iGemrideContainer->SetLoadingL(ETrue, *url8);
        }

    iEngine->FetchL(*url8);

    CleanupStack::PopAndDestroy(2, resolvedUrl);  // url8, resolvedUrl

    UpdateCbaL();
    }

void CgemrideContainerView::GoBackL()
    {
    if (iHistoryStack.Count() == 0)
        return;

    // Pop last URL from history
    TInt lastIndex = iHistoryStack.Count() - 1;
    HBufC8* previousUrl = iHistoryStack[lastIndex];
    iHistoryStack.Remove(lastIndex);

    // Update current URL (don't push to history - we're going back)
    delete iCurrentUrl;
    iCurrentUrl = previousUrl;  // Take ownership

    if (iGemrideContainer)
        {
        iGemrideContainer->SetLoadingL(ETrue, *iCurrentUrl);
        }

    iEngine->FetchL(*iCurrentUrl);

    UpdateCbaL();
    }

TBool CgemrideContainerView::CanGoBack() const
    {
    return iHistoryStack.Count() > 0;
    }

void CgemrideContainerView::UpdateCbaL()
    {
    CEikButtonGroupContainer* cba = Cba();
    if (!cba)
        return;

    if (CanGoBack())
        {
        cba->SetCommandL(2, EGemrideContainerViewBackCommand, _L("Back"));
        }
    else
        {
        cba->SetCommandL(2, EAknSoftkeyExit, _L("Exit"));
        }

    cba->DrawNow();
    }

HBufC* CgemrideContainerView::ResolveUrlLC(const TDesC& aUrl)
    {
    _LIT(KGeminiScheme, "gemini://");
    _LIT(KGopherScheme, "gopher://");
    _LIT(KHttpScheme, "http://");
    _LIT(KHttpsScheme, "https://");

    // Already absolute URL
    if (aUrl.FindF(KGeminiScheme) == 0 ||
        aUrl.FindF(KGopherScheme) == 0 ||
        aUrl.FindF(KHttpScheme) == 0 ||
        aUrl.FindF(KHttpsScheme) == 0)
        {
        return aUrl.AllocLC();
        }

    if (!iCurrentUrl || iCurrentUrl->Length() == 0)
        {
        return aUrl.AllocLC();
        }

    // Convert base to 16-bit
    HBufC* base = HBufC::NewLC(iCurrentUrl->Length());
    base->Des().Copy(*iCurrentUrl);

    // Find scheme end and host end
    TInt schemeEnd = base->Find(_L("://"));
    if (schemeEnd == KErrNotFound)
        {
        CleanupStack::PopAndDestroy(base);
        return aUrl.AllocLC();
        }

    TPtrC afterScheme = base->Mid(schemeEnd + 3);
    TInt hostSlash = afterScheme.Locate('/');
    TInt hostEnd = (hostSlash != KErrNotFound) ? schemeEnd + 3 + hostSlash : base->Length();

    HBufC* result = NULL;

    if (aUrl.Length() > 0 && aUrl[0] == '/')
        {
        // Absolute path from root
        result = HBufC::NewL(hostEnd + aUrl.Length());
        result->Des().Copy(base->Left(hostEnd));
        result->Des().Append(aUrl);
        }
    else
        {
        // Relative path - get directory of current URL
        TInt lastSlash = base->LocateReverse('/');

        TPtrC baseDir;
        if (lastSlash > hostEnd)
            {
            baseDir.Set(base->Left(lastSlash + 1));
            }
        else
            {
            // No path, use host with trailing slash
            baseDir.Set(base->Left(hostEnd));
            }

        // Build combined path
        HBufC* combined = HBufC::NewLC(baseDir.Length() + aUrl.Length() + 1);
        combined->Des().Copy(baseDir);
        if (combined->Length() > 0 && (*combined)[combined->Length()-1] != '/')
            {
            combined->Des().Append('/');
            }
        combined->Des().Append(aUrl);

        // Now resolve .. and . segments
        // Extract path portion (after host)
        TInt combSchemeEnd = combined->Find(_L("://"));
        TPtrC combAfterScheme = combined->Mid(combSchemeEnd + 3);
        TInt combHostSlash = combAfterScheme.Locate('/');

        if (combHostSlash != KErrNotFound)
            {
            TInt pathStart = combSchemeEnd + 3 + combHostSlash;
            TPtrC hostPart = combined->Left(pathStart);
            TPtrC pathPart = combined->Mid(pathStart);

            // Resolve path segments
            CDesCArrayFlat* segments = new (ELeave) CDesCArrayFlat(8);
            CleanupStack::PushL(segments);

            TInt pos = 0;
            while (pos < pathPart.Length())
                {
                TInt nextSlash = pathPart.Mid(pos).Locate('/');
                TPtrC segment;
                if (nextSlash != KErrNotFound)
                    {
                    segment.Set(pathPart.Mid(pos, nextSlash));
                    pos += nextSlash + 1;
                    }
                else
                    {
                    segment.Set(pathPart.Mid(pos));
                    pos = pathPart.Length();
                    }

                if (segment == _L(".."))
                    {
                    // Go up one directory
                    if (segments->Count() > 0)
                        {
                        segments->Delete(segments->Count() - 1);
                        }
                    }
                else if (segment == _L(".") || segment.Length() == 0)
                    {
                    // Skip current dir references and empty segments
                    }
                else
                    {
                    segments->AppendL(segment);
                    }
                }

            // Rebuild path
            TInt totalLen = hostPart.Length() + 1;
            for (TInt i = 0; i < segments->Count(); i++)
                {
                totalLen += (*segments)[i].Length() + 1;
                }

            result = HBufC::NewL(totalLen);
            result->Des().Copy(hostPart);
            for (TInt i = 0; i < segments->Count(); i++)
                {
                result->Des().Append('/');
                result->Des().Append((*segments)[i]);
                }

            // Preserve trailing slash if original URL had one or was a directory
            if (aUrl.Length() > 0 && aUrl[aUrl.Length()-1] == '/')
                {
                result->Des().Append('/');
                }

            CleanupStack::PopAndDestroy(segments);
            }
        else
            {
            result = combined->AllocL();
            }

        CleanupStack::PopAndDestroy(combined);
        }

    CleanupStack::PopAndDestroy(base);

    if (result)
        {
        CleanupStack::PushL(result);
        return result;
        }

    return aUrl.AllocLC();
    }

