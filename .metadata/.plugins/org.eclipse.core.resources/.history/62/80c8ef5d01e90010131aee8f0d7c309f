TInt CGemrideContainer::FindWrapPosition(const TDesC& aText, TInt aMaxChars) const
    {
    if (aText.Length() <= aMaxChars)
        {
        return aText.Length();
        }

    // Look backwards from max position for whitespace
    for (TInt i = aMaxChars - 1; i > 0; i--)
        {
        TChar ch = aText[i];
        if (ch == ' ' || ch == '\t')
            {
            return i + 1;  // Include the space in current line
            }
        }

    // No whitespace found, force break at max
    return aMaxChars;
    }


void CGemrideContainer::Draw(const TRect& aRect) const
    {
    // [[[ begin generated region: do not modify [Generated Contents]
	CWindowGc& gc = SystemGc();
	gc.Clear( aRect );
	
	// ]]] end generated region [Generated Contents]

    const CFont* bodyFont = iEikonEnv->DenseFont();    // Smaller body text
    const CFont* titleFont = iEikonEnv->TitleFont();   // H1
    const CFont* h2Font = iEikonEnv->NormalFont();     // H2

    gc.UseFont(bodyFont);
    gc.SetPenColor(KRgbBlack);

    TInt fontHeight = bodyFont->HeightInPixels();
    TInt baseline = bodyFont->AscentInPixels() + 12;
    TRect textRect = Rect();
    textRect.Shrink(4, 4);

    _LIT(KSample, "ABCDEFGHIJabcdefghij");
    TInt sampleWidth = bodyFont->TextWidthInPixels(KSample);
    TInt avgCharWidth = sampleWidth / 20;
    if (avgCharWidth < 1) avgCharWidth = 6;

    TInt charsPerLine = textRect.Width() / avgCharWidth;
    if (charsPerLine < 20) charsPerLine = 20;

    if (iParser && iParser->LineCount() > 0)
        {
        TInt yPos = baseline;
        TInt maxY = textRect.iBr.iY - fontHeight;
        TInt lineNumber = 0;
        TInt& totalLines = const_cast<TInt&>(iTotalLines);
        totalLines = 0;

        for (TInt i = 0; i < iParser->LineCount(); i++)
            {
            const CGemLine& gemLine = iParser->Line(i);
            TPtrC text = gemLine.Text();

            const CFont* font = bodyFont;
            TInt leftMargin = textRect.iTl.iX;
            TInt wrapChars = charsPerLine;
            TRgb color = KRgbBlack;
            TBuf<8> prefix;
            TInt prefixWidth = 0;
            TBool wordWrap = ETrue;  // Enable word wrap by default

            switch (gemLine.Type())
                {
                case EGemHeading1:
                    font = titleFont;
                    wrapChars = textRect.Width() / (titleFont->TextWidthInPixels(KSample) / 20);
                    if (wrapChars < 10) wrapChars = 10;
                    break;

                case EGemHeading2:
                    font = h2Font;
                    wrapChars = textRect.Width() / (h2Font->TextWidthInPixels(KSample) / 20);
                    if (wrapChars < 10) wrapChars = 10;
                    break;

                case EGemHeading3:
                    font = bodyFont;
                    color = TRgb(0x40, 0x40, 0x40);
                    break;

                case EGemListItem:
                    prefix.Copy(_L("\x2022 "));
                    prefixWidth = font->TextWidthInPixels(prefix);
                    leftMargin += prefixWidth;
                    wrapChars = (textRect.Width() - prefixWidth) / avgCharWidth;
                    break;

                case EGemQuote:
                    prefix.Copy(_L("| "));
                    prefixWidth = font->TextWidthInPixels(prefix);
                    leftMargin += prefixWidth;
                    wrapChars = (textRect.Width() - prefixWidth) / avgCharWidth;
                    color = TRgb(0x60, 0x60, 0x60);
                    break;

                case EGemLink:
                    prefix.Copy(_L("> "));
                    prefixWidth = font->TextWidthInPixels(prefix);
                    leftMargin += prefixWidth;
                    wrapChars = (textRect.Width() - prefixWidth) / avgCharWidth;

                    if (i == iSelectedLink)
                        {
                        // Highlighted link
                        color = TRgb(0xFF, 0xFF, 0xFF);  // White text
                        }
                    else
                        {
                        color = TRgb(0x00, 0x00, 0xCC);  // Blue
                        }
                    break;

                case EGemPreformatted:
                    wrapChars = 10000;
                    wordWrap = EFalse;  // No word wrap for preformatted
                    break;

                default:
                    break;
                }

            TInt lineHeight = font->HeightInPixels() + 2;

            if (gemLine.Type() == EGemHeading1 || 
                gemLine.Type() == EGemHeading2)
                {
                if (lineNumber > 0 && lineNumber >= iScrollOffset)
                    {
                    yPos += lineHeight / 2;
                    }
                }

            if (text.Length() == 0)
                {
                totalLines++;
                if (lineNumber >= iScrollOffset && yPos < maxY)
                    {
                    yPos += lineHeight;
                    }
                lineNumber++;
                continue;
                }

            TPtrC remaining(text);
            TBool firstChunk = ETrue;

            while (remaining.Length() > 0)
                {
                TInt takeLen;
                if (wordWrap)
                    {
                    takeLen = FindWrapPosition(remaining, wrapChars);
                    }
                else
                    {
                    takeLen = Min(remaining.Length(), wrapChars);
                    }

                TPtrC chunk = remaining.Left(takeLen);

                // Trim trailing whitespace from chunk for cleaner display
                while (chunk.Length() > 0 && 
                       (chunk[chunk.Length() - 1] == ' ' || 
                        chunk[chunk.Length() - 1] == '\t'))
                    {
                    chunk.Set(chunk.Left(chunk.Length() - 1));
                    }

                if (lineNumber >= iScrollOffset && yPos < maxY)
                    {
                    gc.UseFont(font);

                    // Draw highlight background for selected link
                    if (gemLine.Type() == EGemLink && i == iSelectedLink)
                        {
                        TInt textWidth = font->TextWidthInPixels(chunk) + prefixWidth;
                        TRect highlightRect(
                            textRect.iTl.iX,
                            yPos - font->AscentInPixels(),
                            textRect.iTl.iX + textWidth,
                            yPos + font->DescentInPixels() + 1
                        );
                        gc.SetBrushStyle(CGraphicsContext::ESolidBrush);
                        gc.SetBrushColor(TRgb(0x00, 0x00, 0xCC));  // Blue background
                        gc.DrawRect(highlightRect);
                        gc.SetBrushStyle(CGraphicsContext::ENullBrush);
                        }

                    gc.SetPenColor(color);

                    if (firstChunk && prefix.Length() > 0)
                        {
                        gc.DrawText(prefix, TPoint(textRect.iTl.iX, yPos));
                        }

                    gc.DrawText(chunk, TPoint(leftMargin, yPos));
                    yPos += lineHeight;
                    }

                totalLines++;
                lineNumber++;
                firstChunk = EFalse;

                if (remaining.Length() > takeLen)
                    {
                    remaining.Set(remaining.Mid(takeLen));
                    // Skip leading whitespace on next line
                    while (remaining.Length() > 0 && 
                           (remaining[0] == ' ' || remaining[0] == '\t'))
                        {
                        remaining.Set(remaining.Mid(1));
                        }
                    }
                else
                    {
                    break;
                    }
                }
            }

        gc.UseFont(bodyFont);
        gc.SetPenColor(KRgbBlack);
        }
    else if (iLoading)
        {
        TInt yPos = baseline;
        TInt lineHeight = bodyFont->HeightInPixels() + 4;

        // "Loading..."
        gc.DrawText(_L("Loading..."), TPoint(textRect.iTl.iX, yPos));
        yPos += lineHeight * 2;

        // "URL: ..."
        if (iCurrentUrl && iCurrentUrl->Length() > 0)
            {
            TBuf<256> urlLine;
            urlLine.Copy(_L("URL: "));
            TInt maxUrlLen = 256 - urlLine.Length();
            if (iCurrentUrl->Length() <= maxUrlLen)
                {
                urlLine.Append(*iCurrentUrl);
                }
            else
                {
                urlLine.Append(iCurrentUrl->Left(maxUrlLen - 3));
                urlLine.Append(_L("..."));
                }
            gc.DrawText(urlLine, TPoint(textRect.iTl.iX, yPos));
            yPos += lineHeight * 2;
            }

        // "Page: X KB"
        TBuf<64> pageLine;
        pageLine.Format(_L("Page: %d KB"), iPageBytes / 1024);
        gc.DrawText(pageLine, TPoint(textRect.iTl.iX, yPos));
        yPos += lineHeight;

        // "Total: X KB"
        TBuf<64> totalLine;
        totalLine.Format(_L("Total: %d KB"), iTotalBytes / 1024);
        gc.DrawText(totalLine, TPoint(textRect.iTl.iX, yPos));
        }
    else
        {
        gc.DrawText(_L("(no data)"), TPoint(textRect.iTl.iX, baseline));
        }

    gc.DiscardFont();
    }

void CGemrideContainer::SetContentL(const TDesC& aContent)
    {
    iLoading = EFalse;
    iScrollOffset = 0;
    iTotalLines = 0;
    delete iContent;
    iContent = NULL;
    iContent = aContent.AllocL();
    iParser->ParseL(aContent);

    // Count links but don't pre-select
    iLinkCount = 0;
    iSelectedLink = -1;

    for (TInt i = 0; i < iParser->LineCount(); i++)
        {
        if (iParser->Line(i).Type() == EGemLink)
            {
            iLinkCount++;
            }
        }

    DrawNow();
    }


void CGemrideContainer::ActivateSelectedLinkL()
    {
    if (!iParser || iSelectedLink < 0)
        return;

    const CGemLine& link = iParser->Line(iSelectedLink);
    if (link.Type() != EGemLink)
        return;

    TPtrC url = link.Url();  // Changed from HBufC*
    if (url.Length() == 0)
        return;

    CgemrideAppUi* appUi = static_cast<CgemrideAppUi*>(iEikonEnv->AppUi());
    if (appUi)
        {
        appUi->NavigateToL(url);
        }
    }


TKeyResponse CGemrideContainer::OfferKeyEventL(const TKeyEvent& aKeyEvent, TEventCode aType)
    {
    if (aType != EEventKey)
        return EKeyWasNotConsumed;

    RDebug::Print(_L("Container: OfferKeyEventL code=%d type=%d"), aKeyEvent.iCode, aType);
 
    switch (aKeyEvent.iCode)
        {
        case EKeyUpArrow:
            {
            // Try to move to previous visible link
            if (iLinkCount > 0 && iSelectedLink >= 0)
                {
                TInt newLink = FindNextLink(iSelectedLink, -1);
                if (newLink >= 0 && IsLinkVisible(newLink))
                    {
                    iSelectedLink = newLink;
                    DrawNow();
                    return EKeyWasConsumed;
                    }
                }
            // No visible link above - scroll one line
            if (iScrollOffset > 0)
                {
                iScrollOffset--;
                DrawNow();
                }
            return EKeyWasConsumed;
            }

        case EKeyDownArrow:
            {
            // Try to move to next visible link
            if (iLinkCount > 0)
                {
                TInt newLink = FindNextLink(iSelectedLink, 1);
                if (newLink >= 0 && IsLinkVisible(newLink))
                    {
                    iSelectedLink = newLink;
                    DrawNow();
                    return EKeyWasConsumed;
                    }
                }
            // No visible link below - scroll one line
            if (iScrollOffset < iTotalLines - 1)
                {
                iScrollOffset++;
                DrawNow();
                }
            return EKeyWasConsumed;
            }

        case EKeyDevice3:
        case EKeyEnter:
            if (iSelectedLink >= 0 && IsLinkVisible(iSelectedLink))
                {
                ActivateSelectedLinkL();
                return EKeyWasConsumed;
                }
            break;
        }

    return EKeyWasNotConsumed;
	// [[[ begin generated region: do not modify [Generated Contents]
	
	// ]]] end generated region [Generated Contents]
	
    }

TInt CGemrideContainer::FindNextLink(TInt aCurrentIndex, TInt aDirection) const
    {
    if (!iParser || iParser->LineCount() == 0)
        return -1;

    TInt count = iParser->LineCount();
    TInt i = aCurrentIndex + aDirection;

    // Don't wrap - just scan in one direction
    while (i >= 0 && i < count)
        {
        if (iParser->Line(i).Type() == EGemLink)
            {
            return i;
            }
        i += aDirection;
        }

    return -1;  // No more links in this direction
    }

TInt CGemrideContainer::GetLineIndexForLink(TInt aLinkIndex) const
    {
    if (!iParser || aLinkIndex < 0)
        return 0;

    const CFont* bodyFont = iEikonEnv->DenseFont();
    _LIT(KSample, "ABCDEFGHIJabcdefghij");
    TInt avgCharWidth = bodyFont->TextWidthInPixels(KSample) / 20;
    if (avgCharWidth < 1) avgCharWidth = 6;

    TRect textRect = Rect();
    textRect.Shrink(4, 4);
    TInt charsPerLine = textRect.Width() / avgCharWidth;
    if (charsPerLine < 20) charsPerLine = 20;

    TInt lineNumber = 0;

    for (TInt i = 0; i < aLinkIndex && i < iParser->LineCount(); i++)
        {
        const CGemLine& gemLine = iParser->Line(i);
        TPtrC text = gemLine.Text();

        TInt wrapChars = charsPerLine;
        if (gemLine.Type() == EGemLink || 
            gemLine.Type() == EGemListItem ||
            gemLine.Type() == EGemQuote)
            {
            wrapChars -= 2;
            }

        if (text.Length() == 0)
            {
            lineNumber++;
            }
        else
            {
            // Count wrapped lines
            TInt pos = 0;
            while (pos < text.Length())
                {
                TPtrC remaining = text.Mid(pos);
                TInt take = FindWrapPosition(remaining, wrapChars);
                lineNumber++;
                pos += take;
                // Skip whitespace
                while (pos < text.Length() && 
                       (text[pos] == ' ' || text[pos] == '\t'))
                    {
                    pos++;
                    }
                }
            }

        }
    return lineNumber;
    }
    

void CGemrideContainer::EnsureLinkVisible()
    {
    if (iSelectedLink < 0)
        return;

    TInt linkLine = GetLineIndexForLink(iSelectedLink);

    const CFont* bodyFont = iEikonEnv->DenseFont();
    TInt lineHeight = bodyFont->HeightInPixels() + 2;
    TRect textRect = Rect();
    textRect.Shrink(4, 4);

    TInt usableHeight = textRect.Height() - bodyFont->HeightInPixels();
    TInt visibleLines = usableHeight / lineHeight;
    if (visibleLines < 1) visibleLines = 1;

    // Ensure link is visible - jump if needed
    if (linkLine < iScrollOffset)
        {
        iScrollOffset = linkLine;
        }
    else if (linkLine >= iScrollOffset + visibleLines - 1)
        {
        iScrollOffset = linkLine - visibleLines + 2;
        if (iScrollOffset < 0) iScrollOffset = 0;
        }
    }

TBool CGemrideContainer::IsLinkVisible(TInt aLinkIndex) const
    {
    if (aLinkIndex < 0 || !iParser)
        return EFalse;

    TInt linkLine = GetLineIndexForLink(aLinkIndex);

    const CFont* bodyFont = iEikonEnv->DenseFont();
    TInt lineHeight = bodyFont->HeightInPixels() + 2;
    TRect textRect = Rect();
    textRect.Shrink(4, 4);

    TInt usableHeight = textRect.Height() - bodyFont->HeightInPixels();
    TInt visibleLines = usableHeight / lineHeight;
    if (visibleLines < 1) visibleLines = 1;

    return (linkLine >= iScrollOffset && linkLine < iScrollOffset + visibleLines);
    }

TInt CGemrideContainer::LoadingTimerCallback(TAny* aPtr)
    {
    CGemrideContainer* self = static_cast<CGemrideContainer*>(aPtr);
    self->DrawNow();
    return KErrNone;  // Continue timer
    }

void CGemrideContainer::SetLoadingL(TBool aLoading, const TDesC8& aUrl)
    {
    iLoading = aLoading;

    if (aLoading)
        {
        // Reset page bytes for new page
        iPageBytes = 0;

        // Store URL without protocol
        delete iCurrentUrl;
        iCurrentUrl = NULL;

        TPtrC8 urlPtr(aUrl);
        _LIT8(KGeminiPrefix, "gemini://");
        if (urlPtr.FindF(KGeminiPrefix) == 0)
            {
            urlPtr.Set(urlPtr.Mid(KGeminiPrefix().Length()));
            }

        iCurrentUrl = HBufC::NewL(urlPtr.Length());
        iCurrentUrl->Des().Copy(urlPtr);

        // Start timer (1 second interval)
        if (!iLoadingTimer)
            {
            iLoadingTimer = CPeriodic::NewL(CActive::EPriorityStandard);
            }
        else
            {
            iLoadingTimer->Cancel();
            }

        const TInt KOneSecond = 1000000;
        iLoadingTimer->Start(KOneSecond, KOneSecond, 
            TCallBack(LoadingTimerCallback, this));
        }
    else
        {
        // Stop timer
        if (iLoadingTimer)
            {
            iLoadingTimer->Cancel();
            }
        }

    DrawNow();
    }

void CGemrideContainer::AddBytesReceived(TInt aBytes)
    {
    iPageBytes += aBytes;
    iTotalBytes += aBytes;
    }
