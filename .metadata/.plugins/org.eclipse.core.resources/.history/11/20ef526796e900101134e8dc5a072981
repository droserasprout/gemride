void CgemrideContainerView::PushCurrentUrlL()
    {
    if (iCurrentUrl && iCurrentUrl->Length() > 0)
        {
        HBufC8* urlCopy = iCurrentUrl->AllocLC();
        iHistoryStack.AppendL(urlCopy);
        CleanupStack::Pop(urlCopy);
        }
    }

void CgemrideContainerView::NavigateToL(const TDesC& aUrl)
    {
    if (!iEngine)
        return;

    HBufC* resolvedUrl = ResolveUrlLC(aUrl);

    // Print bytes to avoid ~ format issue
    RDebug::Print(_L("NavigateToL: resolved len=%d"), resolvedUrl->Length());
    TBuf8<256> url8Debug;
    url8Debug.Copy(resolvedUrl->Left(Min(resolvedUrl->Length(), 256)));
    //RDebug::Printf("NavigateToL: resolved URL = %.*s", url8Debug.Length(), url8Debug.Ptr());

    PushCurrentUrlL();

    HBufC8* url8 = HBufC8::NewLC(resolvedUrl->Length());
    url8->Des().Copy(*resolvedUrl);

    delete iCurrentUrl;
    iCurrentUrl = NULL;
    iCurrentUrl = url8->AllocL();

    RDebug::Printf("NavigateToL: calling SetLoadingL");

    if (iGemrideContainer)
        {
        iGemrideContainer->SetLoadingL(ETrue, *url8);
        }

    RDebug::Printf("NavigateToL: calling FetchL");
    iEngine->FetchL(*url8);
    RDebug::Printf("NavigateToL: FetchL returned");

    CleanupStack::PopAndDestroy(2, resolvedUrl);

    UpdateCbaL();
    }


void CgemrideContainerView::GoBackL()
    {
    if (iHistoryStack.Count() == 0)
        return;

    // Pop last URL from history
    TInt lastIndex = iHistoryStack.Count() - 1;
    HBufC8* previousUrl = iHistoryStack[lastIndex];
    iHistoryStack.Remove(lastIndex);

    // Update current URL (don't push to history - we're going back)
    delete iCurrentUrl;
    iCurrentUrl = previousUrl;  // Take ownership

    if (iGemrideContainer)
        {
        iGemrideContainer->SetLoadingL(ETrue, *iCurrentUrl);
        }

    iEngine->FetchL(*iCurrentUrl);

    UpdateCbaL();
    }

TBool CgemrideContainerView::CanGoBack() const
    {
    return iHistoryStack.Count() > 0;
    }

void CgemrideContainerView::UpdateCbaL()
    {
    CEikButtonGroupContainer* cba = Cba();
    if (!cba)
        return;

    if (CanGoBack())
        {
        cba->SetCommandL(2, EGemrideContainerViewBackCommand, _L("Back"));
        }
    else
        {
        cba->SetCommandL(2, EAknSoftkeyExit, _L("Exit"));
        }

    cba->DrawNow();
    }

HBufC* CgemrideContainerView::ResolveUrlLC(const TDesC& aUrl)
    {
    _LIT(KGeminiScheme, "gemini://");
    const TInt KSchemeLen = 9;

    // Already absolute URL
    if (aUrl.Length() >= KSchemeLen && aUrl.Left(KSchemeLen).CompareF(KGeminiScheme) == 0)
        {
        return aUrl.AllocLC();
        }

    if (!iCurrentUrl || iCurrentUrl->Length() == 0)
        {
        return aUrl.AllocLC();
        }

    RDebug::Print(_L("ResolveUrl: iCurrentUrl len=%d"), iCurrentUrl->Length());

    // Convert base to 16-bit - allocate exact size needed
    TInt baseLen = iCurrentUrl->Length();
    HBufC* base = HBufC::NewLC(baseLen);
    TPtr basePtr = base->Des();

    // Manual copy to avoid any descriptor issues
    for (TInt i = 0; i < baseLen; i++)
        {
        basePtr.Append(TChar((*iCurrentUrl)[i]));
        }

    RDebug::Print(_L("ResolveUrl: base len=%d"), base->Length());

    // Find host end
    TInt hostEnd = KSchemeLen;
    while (hostEnd < base->Length() && (*base)[hostEnd] != '/')
        {
        hostEnd++;
        }

    RDebug::Print(_L("ResolveUrl: hostEnd=%d"), hostEnd);

    HBufC* result = NULL;

    if (aUrl.Length() > 0 && aUrl[0] == '/')
        {
        // Absolute path from host root
        result = HBufC::NewL(hostEnd + aUrl.Length());
        result->Des().Copy(base->Left(hostEnd));
        result->Des().Append(aUrl);
        }
    else
        {
        // Find last slash for base directory
        TInt lastSlash = base->Length() - 1;
        while (lastSlash > hostEnd && (*base)[lastSlash] != '/')
            {
            lastSlash--;
            }

        RDebug::Print(_L("ResolveUrl: lastSlash=%d"), lastSlash);

        // Count ../ prefixes
        TInt relStart = 0;
        TInt dirsUp = 0;

        while (relStart + 3 <= aUrl.Length() && aUrl.Mid(relStart, 3).Compare(_L("../")) == 0)
            {
            dirsUp++;
            relStart += 3;
            }

        if (relStart + 2 == aUrl.Length() && aUrl.Mid(relStart, 2).Compare(_L("..")) == 0)
            {
            dirsUp++;
            relStart += 2;
            }

        RDebug::Print(_L("ResolveUrl: dirsUp=%d relStart=%d"), dirsUp, relStart);

        // Go up directories from lastSlash
        TInt baseEnd = lastSlash;
        for (TInt i = 0; i < dirsUp && baseEnd > hostEnd; i++)
            {
            baseEnd--;  // Move before current slash
            while (baseEnd > hostEnd && (*base)[baseEnd] != '/')
                {
                baseEnd--;
                }
            }

        RDebug::Print(_L("ResolveUrl: baseEnd=%d"), baseEnd);

        // Build result
        TPtrC remainder = aUrl.Mid(relStart);
        TInt resultLen = baseEnd + 1 + remainder.Length();
        result = HBufC::NewL(resultLen);
        result->Des().Copy(base->Left(baseEnd + 1));  // Include slash
        result->Des().Append(remainder);

        RDebug::Print(_L("ResolveUrl: result len=%d"), result->Length());
        }

    CleanupStack::PopAndDestroy(base);
    CleanupStack::PushL(result);
    return result;
    }

