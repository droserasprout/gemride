#include "CGeminiEngine.h"

CCGeminiEngine::CCGeminiEngine() :
	CActive(EPriorityStandard) // Standard priority
	{
	}

CCGeminiEngine* CCGeminiEngine::NewLC()
	{
	CCGeminiEngine* self = new ( ELeave ) CCGeminiEngine();
	CleanupStack::PushL(self);
	self->ConstructL();
	return self;
	}

CCGeminiEngine* CCGeminiEngine::NewL()
	{
	CCGeminiEngine* self = CCGeminiEngine::NewLC();
	CleanupStack::Pop(); // self;
	return self;
	}

void CCGeminiEngine::ConstructL()
	{
	User::LeaveIfError(iTimer.CreateLocal() ); // Initialize timer
	CActiveScheduler::Add( this); // Add to scheduler
	}

CCGeminiEngine::~CCGeminiEngine()
	{
	Cancel(); // Cancel any request, if outstanding
	iTimer.Close(); // Destroy the RTimer object
	// Delete instance variables if any
	}

void CCGeminiEngine::DoCancel()
	{
	iTimer.Cancel();
	}

void CCGeminiEngine::StartL(TTimeIntervalMicroSeconds32 aDelay)
	{
	Cancel(); // Cancel any request, just to be sure
	iState = EUninitialized;
	iTimer.After(iStatus, aDelay); // Set for later
	SetActive(); // Tell scheduler a request is active
	}

void CCGeminiEngine::RunL()
	{
	if (iState == EUninitialized)
		{
		// Do something the first time RunL() is called
		iState = EInitialized;
		}
	else
		if (iState != EError)
			{
			// Do something
			}
	iTimer.After(iStatus, 1000000); // Set for 1 sec later
	SetActive(); // Tell scheduler a request is active
	}

TInt CCGeminiEngine::RunError(TInt aError)
	{
	return aError;
	}
